{
  "name": "voltcraft",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted Tesla Fleet companion — local-only, Docker-powered, API-efficient.",
  "scripts": {
    "dev:api": "pnpm --filter @voltcraft/api dev",
    "dev:web": "pnpm --filter @voltcraft/web dev",
    "build:api": "pnpm --filter @voltcraft/api build",
    "build:web": "pnpm --filter @voltcraft/web build",
    "db:generate": "pnpm --filter @voltcraft/api prisma:generate",
    "db:migrate": "pnpm --filter @voltcraft/api prisma:migrate",
    "db:seed": "pnpm --filter @voltcraft/api prisma:seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  }
}
