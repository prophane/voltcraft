# =================================================================
# Voltcraft — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to git.
# =================================================================

# -----------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------
POSTGRES_DB=voltcraft
POSTGRES_USER=voltcraft
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_PORT=5432

# -----------------------------------------------------------------
# Redis
# -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# -----------------------------------------------------------------
# MQTT (Mosquitto)
# -----------------------------------------------------------------
MQTT_ENABLED=false
MQTT_PORT=1883
MQTT_USERNAME=voltcraft
MQTT_PASSWORD=CHANGE_ME_mqtt_password

# -----------------------------------------------------------------
# Session & Encryption
# -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64chars_random_hex_string_here_min_32bytes_required
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32bytes_hex_key_for_aes256_token_encryption

# -----------------------------------------------------------------
# Authentication mode
# -----------------------------------------------------------------
# true  -> Voltcraft trusts upstream reverse proxy / SSO / pre-auth
# false -> Voltcraft shows its own login and admin setup flow
AUTH_DISABLED=true

# -----------------------------------------------------------------
# Tesla Fleet API configuration
# Tesla OAuth app credentials can be configured later from the Voltcraft UI.
# Runtime changes made from the UI are persisted in APP_CONFIG_PATH.
# -----------------------------------------------------------------
# Region: na | eu | cn
TESLA_REGION=na
# OAuth app credentials
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://voltcraft.ph4.fr/api/auth/tesla/callback
# Internal Tesla signed-command proxy URL
TESLA_COMMAND_PROXY_URL=https://vehicle-command:4443
# Runtime config file persisted inside the app-config volume
APP_CONFIG_PATH=/app/data/runtime.env

# -----------------------------------------------------------------
# API Backend
# -----------------------------------------------------------------
API_PORT=3001
LOG_LEVEL=info

# -----------------------------------------------------------------
# Web Frontend
# -----------------------------------------------------------------
WEB_PORT=3000
# URL the browser uses to reach the API (used at build time)
VITE_API_URL=http://localhost:3001
# Force frontend to bypass local login page in the browser build if needed
VITE_FORCE_NO_AUTH=false

# -----------------------------------------------------------------
# TeslaMate (optional profile: --profile teslamate)
# -----------------------------------------------------------------
# Web UI
TESLAMATE_PORT=4000
TESLAMATE_GRAFANA_PORT=3002

# Dedicated TeslaMate PostgreSQL
TESLAMATE_DB_HOST=teslamate-db
TESLAMATE_DB_PORT=5432
TESLAMATE_DB_NAME=teslamate
TESLAMATE_DB_USER=teslamate
TESLAMATE_DB_PASSWORD=CHANGE_ME_teslamate_db_password

# TeslaMate crypto key
# Generate with: openssl rand -hex 32
TESLAMATE_ENCRYPTION_KEY=CHANGE_ME_teslamate_64chars_random_hex_key

# Grafana admin (TeslaMate dashboards)
TESLAMATE_GRAFANA_USER=admin
TESLAMATE_GRAFANA_PASSWORD=CHANGE_ME_teslamate_grafana_password
TESLAMATE_BACKEND_ONLY=true
# Force TeslaMate distance/odometer/speed conversion from miles to kilometers
TESLAMATE_FORCE_MILES_TO_KM=true

# -----------------------------------------------------------------
# App behavior
# -----------------------------------------------------------------
# Default eco mode: limits polling to minimize Tesla API usage
ECO_MODE_ENABLED=true
# Default locale
TIMEZONE=Europe/Paris
