# =================================================================
# Voltcraft — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to git.
# =================================================================

# -----------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------
POSTGRES_DB=voltcraft
POSTGRES_USER=voltcraft
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_PORT=5432

# -----------------------------------------------------------------
# Redis
# -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# -----------------------------------------------------------------
# MQTT (Mosquitto)
# -----------------------------------------------------------------
MQTT_PORT=1883
MQTT_USERNAME=voltcraft
MQTT_PASSWORD=CHANGE_ME_mqtt_password

# -----------------------------------------------------------------
# Session & Encryption
# -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64chars_random_hex_string_here_min_32bytes_required
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32bytes_hex_key_for_aes256_token_encryption

# -----------------------------------------------------------------
# Tesla Fleet API configuration
# Bearer token can also be set from the Voltcraft Settings UI
# -----------------------------------------------------------------
TESLA_TOKEN=
# Region: na | eu | cn
TESLA_REGION=na
# OAuth app credentials (recommended for automatic Tesla connect)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://voltcraft.ph4.fr/api/auth/tesla/callback

# -----------------------------------------------------------------
# API Backend
# -----------------------------------------------------------------
API_PORT=3001
LOG_LEVEL=info

# -----------------------------------------------------------------
# Web Frontend
# -----------------------------------------------------------------
WEB_PORT=3000
# URL the browser uses to reach the API (used at build time)
VITE_API_URL=http://localhost:3001
# Force frontend to bypass local login page (useful with upstream SSO/pre-auth reverse proxy)
VITE_FORCE_NO_AUTH=false

# -----------------------------------------------------------------
# App behavior
# -----------------------------------------------------------------
# Default eco mode: limits polling to minimize Tesla API usage
ECO_MODE_ENABLED=true
# Default locale
TIMEZONE=Europe/Paris
