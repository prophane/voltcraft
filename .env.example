# =================================================================
# Voltcraft — Variables d'environnement
# Copier ce fichier vers .env puis renseigner les valeurs necessaires.
# Ne jamais versionner le fichier .env.
# =================================================================

# -----------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------
POSTGRES_DB=voltcraft
POSTGRES_USER=voltcraft
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_PORT=5432

# -----------------------------------------------------------------
# Redis
# -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# -----------------------------------------------------------------
# MQTT (Mosquitto)
# -----------------------------------------------------------------
MQTT_ENABLED=false
MQTT_PORT=1883
MQTT_USERNAME=voltcraft
MQTT_PASSWORD=CHANGE_ME_mqtt_password

# -----------------------------------------------------------------
# Session et chiffrement
# -----------------------------------------------------------------
# Generer avec: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64chars_random_hex_string_here_min_32bytes_required
# Generer avec: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32bytes_hex_key_for_aes256_token_encryption

# -----------------------------------------------------------------
# Mode d'authentification
# -----------------------------------------------------------------
# true  -> Voltcraft fait confiance au reverse proxy / SSO / pre-auth amont
# false -> Voltcraft affiche sa propre connexion et son propre setup admin
AUTH_DISABLED=true

# -----------------------------------------------------------------
# Configuration Tesla Fleet API
# Les identifiants OAuth Tesla peuvent aussi etre configures depuis l'interface Voltcraft.
# Les changements faits depuis l'interface sont persistes dans APP_CONFIG_PATH.
# -----------------------------------------------------------------
# Region: na | eu | cn
TESLA_REGION=na
# Identifiants OAuth Tesla
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://voltcraft.ph4.fr/api/auth/tesla/callback
# URL interne du proxy Tesla pour commandes signees
TESLA_COMMAND_PROXY_URL=https://vehicle-command:4443
# Fichier runtime persiste dans le volume app-config
APP_CONFIG_PATH=/app/data/runtime.env

# -----------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------
API_PORT=3001
LOG_LEVEL=info

# -----------------------------------------------------------------
# Frontend web
# -----------------------------------------------------------------
WEB_PORT=3000
# URL utilisee par le navigateur pour joindre l'API (utilisee au build)
# Laisser /api pour une installation derriere le meme domaine en production.
VITE_API_URL=/api
# Cible de l'API uniquement pour le proxy Vite en developpement local.
VITE_DEV_API_TARGET=http://localhost:3001
# Permet au frontend de bypasser la page de login locale si necessaire
VITE_FORCE_NO_AUTH=false

# -----------------------------------------------------------------
# TeslaMate (obligatoire)
# -----------------------------------------------------------------
# Interface web
TESLAMATE_PORT=4000
TESLAMATE_GRAFANA_PORT=3002

# PostgreSQL dedie a TeslaMate
TESLAMATE_DB_HOST=teslamate-db
TESLAMATE_DB_PORT=5432
TESLAMATE_DB_NAME=teslamate
TESLAMATE_DB_USER=teslamate
TESLAMATE_DB_PASSWORD=CHANGE_ME_teslamate_db_password

# Cle de chiffrement TeslaMate
# Generer avec: openssl rand -hex 32
TESLAMATE_ENCRYPTION_KEY=CHANGE_ME_teslamate_64chars_random_hex_key

# Admin Grafana (dashboards TeslaMate)
TESLAMATE_GRAFANA_USER=admin
TESLAMATE_GRAFANA_PASSWORD=CHANGE_ME_teslamate_grafana_password
TESLAMATE_BACKEND_ONLY=true
# Force la conversion TeslaMate miles -> kilometres
TESLAMATE_FORCE_MILES_TO_KM=true

# -----------------------------------------------------------------
# Comportement applicatif
# -----------------------------------------------------------------
# Mode eco par defaut: limite le polling pour reduire les appels Tesla API
ECO_MODE_ENABLED=true
# Fuseau horaire par defaut
TIMEZONE=Europe/Paris
